// HR Analytics project - Power BI measures and calculated columns
// Tables imported from data/clean: Employee (employee_clean), Performance (performance_clean),
// EducationLevel, RatingLevel, SatisfiedLevel.
// Relationships: Employee[EmployeeID] (1) -> Performance[EmployeeID] (*)
//                EducationLevel[EducationLevelID] (1) -> Employee[Education] (*)

// ---------- Calculated columns (Table view > Employee > New column) ----------

Age Group =
SWITCH (
    TRUE (),
    Employee[Age] <= 25, "18-25",
    Employee[Age] <= 35, "26-35",
    Employee[Age] <= 45, "36-45",
    "46-55"
)

Tenure Band =
IF ( Employee[YearsAtCompany] <= 2, "0-2 years", "3+ years" )

// ---------- Measures (create them in a table called "Measures") ----------

Total Employees = COUNTROWS ( Employee )

Employees Left =
CALCULATE ( COUNTROWS ( Employee ), Employee[Attrition] = "Yes" )

Attrition Rate = DIVIDE ( [Employees Left], [Total Employees] )

Median Salary = MEDIAN ( Employee[Salary] )

Average Salary = AVERAGE ( Employee[Salary] )

Overtime Attrition Rate =
CALCULATE ( [Attrition Rate], Employee[OverTime] = "Yes" )

No Overtime Attrition Rate =
CALCULATE ( [Attrition Rate], Employee[OverTime] = "No" )

// Difference in percentage points (example: 0.201 = 20.1 points)
Overtime Gap = [Overtime Attrition Rate] - [No Overtime Attrition Rate]

First 2 Years Attrition Rate =
CALCULATE ( [Attrition Rate], Employee[YearsAtCompany] <= 2 )

High-Risk Employees =
CALCULATE (
    [Total Employees],
    Employee[OverTime] = "Yes",
    Employee[YearsAtCompany] <= 2
)

High-Risk Leavers =
CALCULATE (
    [Employees Left],
    Employee[OverTime] = "Yes",
    Employee[YearsAtCompany] <= 2
)

High-Risk Attrition Rate = DIVIDE ( [High-Risk Leavers], [High-Risk Employees] )

High-Risk Share of Leavers = DIVIDE ( [High-Risk Leavers], [Employees Left] )

Reviews = COUNTROWS ( Performance )

Avg Self Rating = AVERAGE ( Performance[SelfRating] )

Avg Manager Rating = AVERAGE ( Performance[ManagerRating] )

Rating Gap = [Avg Manager Rating] - [Avg Self Rating]

Employees Without Review =
COUNTROWS (
    FILTER ( Employee, COUNTROWS ( RELATEDTABLE ( Performance ) ) = 0 )
)

// ---------- Expected values with no filters (use them to check) ----------
// Total Employees = 1,470 | Employees Left = 237 | Attrition Rate = 16.1%
// Overtime Attrition Rate = 30.5% | No Overtime Attrition Rate = 10.4%
// First 2 Years Attrition Rate = 29.7%
// High-Risk Employees = 154 | High-Risk Attrition Rate = 48.1% | High-Risk Share of Leavers = 31.2%
// Reviews = 6,709 | Employees Without Review = 190
// Avg Self Rating = 3.98 | Avg Manager Rating = 3.47
